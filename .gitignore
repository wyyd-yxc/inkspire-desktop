# 依赖
node_modules/

# 构建产物
dist/
dist-electron/
out/
build/**
# 例外：应用图标为源资产（electron-builder buildResources），需入库
!build/
!build/icon.ico
!build/icon.png
release/

# 日志与缓存
logs/
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# 编辑器/系统
.vscode/
.idea/
*.swp

# 本地环境变量与私密配置（API Key 一律不进仓库）
.env
.env.*
*.local

# 数据库与用户数据（开发期本地测试库不入库）
*.sqlite
*.sqlite3
*.db
data/

# 验收过程产物（临时截图等）
tmp/

# 设计参考图（第三方界面截图，版权原因不入公开仓库）
refs/

# ZCode 会话文件
.zcode/
